# =============================================================================
# mG-SCALE Backend – Environment Variables
# =============================================================================
# Copy to .env and fill in values. The app reads UPPER_SNAKE_CASE names.
#
# Production (e.g. Azure App Service) often uses kebab-case. Set the
# UPPER_SNAKE_CASE name below; if your host only allows kebab-case, configure
# it to set the equivalent (e.g. admin-default-password → ADMIN_DEFAULT_PASSWORD).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Production: db-user, db-password, db-host, db-port, db-name
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# -----------------------------------------------------------------------------
# Security (required)
# -----------------------------------------------------------------------------
# Production: secret-key
SECRET_KEY=

# -----------------------------------------------------------------------------
# Admin & MyGrape (required)
# -----------------------------------------------------------------------------
# Production: admin-email, admin-default-password, mygrape-admin-email, mygrape-admin-password
ADMIN_EMAIL=
ADMIN_DEFAULT_PASSWORD=
MYGRAPE_ADMIN_EMAIL=
MYGRAPE_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# URLs & CORS (required)
# -----------------------------------------------------------------------------
# Production: frontend-url, backend-url, allowed-origins
FRONTEND_URL=
BACKEND_URL=
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Production: environment, host, port, reload, debug
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
RELOAD=true

# -----------------------------------------------------------------------------
# IoT (required)
# -----------------------------------------------------------------------------
# Production: iot-client-id, iot-client-secret, iot-account-id
IOT_CLIENT_ID=
IOT_CLIENT_SECRET=
IOT_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Email – SendGrid (optional; used if set)
# -----------------------------------------------------------------------------
# Production: sendgrid-api-key, sendgrid-from-email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Email – SMTP / sender (optional; if used by your deployment)
# -----------------------------------------------------------------------------
# Production: sender-email, sender-password, smtp-server, smtp-port, email-service
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=
SMTP_PORT=
EMAIL_SERVICE=

# -----------------------------------------------------------------------------
# Redis (optional; has defaults)
# -----------------------------------------------------------------------------
# Production: redis-host, redis-port, redis-db, redis-password, redis-ssl,
#            redis-socket-connect-timeout, redis-socket-timeout
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=10
REDIS_SSL=true
REDIS_SSL_CERT_REQS=required

# -----------------------------------------------------------------------------
# APIs (optional)
# -----------------------------------------------------------------------------
# Production: weather-api-key, weather-api-provider, flightradar24-api-key,
#            arc-api-token, arc-api-url, google-maps (if used)
WEATHER_API_KEY=
WEATHER_API_PROVIDER=weatherapi
GOOGLE_MAPS_API_KEY=
FLIGHTRADAR24_API_KEY=
ARC_API_TOKEN=
ARC_IVF_TOKEN_ID=

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Production: audit-log (if supported)
AUDIT_LOG_ENABLED=true

# -----------------------------------------------------------------------------
# Alert API (production / external; set if your deployment uses them)
# -----------------------------------------------------------------------------
# Production: alert-api-base-url, alert-api-endpoint, alert-api-timeout
ALERT_API_BASE_URL=
ALERT_API_ENDPOINT=
ALERT_API_TIMEOUT=

# -----------------------------------------------------------------------------
# Application Insights (Azure)
# -----------------------------------------------------------------------------
# Production: applicationinsights-connection-string, applicationinsightsagent-extension-version
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTSAGENT_EXTENSION_VERSION=

# -----------------------------------------------------------------------------
# Docker / registry
# -----------------------------------------------------------------------------
# Production: docker-registry-server-url
DOCKER_REGISTRY_SERVER_URL=

# -----------------------------------------------------------------------------
# Event Hub (Azure)
# -----------------------------------------------------------------------------
# Production: event-hub-connection-string, event-hub-name, eventhub-connection, eventhub-name
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=
EVENTHUB_CONNECTION=
EVENTHUB_NAME=

# -----------------------------------------------------------------------------
# Tive webhook
# -----------------------------------------------------------------------------
# Production: tive-webhook-key
TIVE_WEBHOOK_KEY=

# -----------------------------------------------------------------------------
# Azure App Service / platform
# -----------------------------------------------------------------------------
# Production: websites-enable-app-service-storage, xdt-microsoftapplicationinsights-mode
WEBSITES_ENABLE_APP_SERVICE_STORAGE=
XDT_MICROSOFTAPPLICATIONINSIGHTS_MODE=
